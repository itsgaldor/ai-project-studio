# ============================================================
# AI Product Studio — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ─── Database (Neon) ─────────────────────────────────────────
# Get from: https://console.neon.tech → Your project → Connection string
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── Anthropic / Claude ──────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Slack ───────────────────────────────────────────────────
# Get from: https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX"

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://ai-product-studio.vercel.app"
# Development: NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Cron Security ───────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Add the same value in Vercel → Project Settings → Cron Job Secret
CRON_SECRET="your-super-secret-cron-key-here"

# ─── Optional: Feature Flags ─────────────────────────────────
# ENABLE_DISCOVERY_CRON="true"
# MAX_DISCOVERY_PROJECTS_PER_RUN="10"
# CLAUDE_DEFAULT_MODEL="claude-opus-4-6"
# CLAUDE_FAST_MODEL="claude-haiku-4-5-20251001"
